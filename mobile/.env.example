# Copy to .env for local development (Expo automatically inlines EXPO_PUBLIC_ vars).
# Point this at your locally running backend (see ../backend/README.md), using
# your computer's LAN IP (not "localhost") if testing on a physical device
# with Expo Go, e.g. http://192.168.1.42:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
