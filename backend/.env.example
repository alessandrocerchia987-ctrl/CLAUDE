# Copy this file to .env and fill in real values before running in production.

# Port the Express server listens on
PORT=4000

# Secret used to sign JWTs — set a long random value in production
JWT_SECRET=change-this-to-a-long-random-secret

# How long issued JWTs stay valid. Long by default so users stay logged in
# until they explicitly log out, rather than getting silently signed out.
JWT_EXPIRES_IN=365d

# Directory where SQLite DB file + uploaded photos are persisted.
# On Render/Railway, point this at a mounted persistent disk.
DATA_DIR=./data

# Optional override for the public base URL used to build absolute photo
# URLs. Leave unset — the server now auto-detects it per request from
# whatever host the client actually used (LAN IP, localhost, or the public
# Render domain), so this only matters if you need to force a different
# value (e.g. a custom domain in front of a proxy).
# PUBLIC_BASE_URL=https://empregoja-api.onrender.com

# SMTP credentials used to email Customer Support / report submissions.
# Simplest option: a Gmail account with an "App Password" (see
# backend/README.md for the 2-minute setup) — SMTP_USER is the full Gmail
# address, SMTP_PASS is the 16-character app password (not your normal
# Gmail password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=your-16-char-app-password

# Where support/report submissions are emailed to. Defaults to
# alecerchia6@gmail.com if unset.
# SUPPORT_EMAIL_TO=alecerchia6@gmail.com

# ZumboPay — required for any paid action (e.g. unlocking a contact) to
# work. Get these from the ZumboPay Panel → Developers.
# ZUMBOPAY_API_KEY=zk_live_xxxxxxxxxxxxxxxx
# ZUMBOPAY_MERCHANT_ID=MCH_XXXXXXXXXX
# Wallet IDs (UUIDs, from GET /wallets — NOT the 6-digit code shown in the
# dashboard) — one per method you accept. At least one is required.
# ZUMBOPAY_WALLET_MPESA=
# ZUMBOPAY_WALLET_EMOLA=
# ZUMBOPAY_WALLET_CARD=
# Shown when you configure the webhook URL in Panel → Developers — verifies
# that webhook requests really came from ZumboPay.
# ZUMBOPAY_WEBHOOK_SECRET=
